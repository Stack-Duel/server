{
  "$schema": "http://json.schemastore.org/template",
  "author": "Stack Duel",
  "classifications": ["StackDuel", "CQRS", "Service"],
  "identity": "StackDuel.Templates.Service",
  "name": "StackDuel Application Service",
  "shortName": "sd-service",
  "tags": { "language": "C#", "type": "item" },
  "sourceName": "Sample",
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "__NAMESPACE__",
      "defaultValue": "StackDuel.Application",
      "description": "Namespace for the generated service interface and implementation."
    },
    "testNamespace": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "__TEST_NAMESPACE__",
      "defaultValue": "StackDuel.Application.Tests.Services",
      "description": "Namespace for the generated test file."
    },
    "skipTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Skip generating the test file."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(skipTests)",
          "exclude": ["StackDuel.Application.Tests/**"]
        }
      ]
    }
  ]
}
