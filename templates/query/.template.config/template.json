{
  "$schema": "http://json.schemastore.org/template",
  "author": "Stack Duel",
  "classifications": ["StackDuel", "CQRS", "Query"],
  "identity": "StackDuel.Templates.Query",
  "name": "StackDuel CQRS Query",
  "shortName": "stackduel-query",
  "tags": { "language": "C#", "type": "item" },
  "sourceName": "Sample",
  "symbols": {
    "response": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "__RESPONSE__",
      "isRequired": true,
      "description": "The TResult type the query resolves to, i.e. IQuery<TResult> (e.g. a Dto type)."
    },
    "namespace": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "__NAMESPACE__",
      "defaultValue": "StackDuel.Application.Queries",
      "description": "Namespace for the generated query/handler."
    }
  }
}
