{
  "$schema": "http://json.schemastore.org/template",
  "author": "Stack Duel",
  "classifications": ["StackDuel", "CQRS", "Command"],
  "identity": "StackDuel.Templates.Command",
  "name": "StackDuel CQRS Command",
  "shortName": "stackduel-command",
  "tags": { "language": "C#", "type": "item" },
  "sourceName": "Sample",
  "symbols": {
    "response": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "__RESPONSE__",
      "isRequired": true,
      "description": "The TResult type the command resolves to, i.e. ICommand<TResult> (e.g. Guid)."
    },
    "namespace": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "__NAMESPACE__",
      "defaultValue": "StackDuel.Application.Commands",
      "description": "Namespace for the generated command/handler/validator."
    }
  }
}
