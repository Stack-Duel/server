{
  "$schema": "http://json.schemastore.org/template",
  "author": "Stack Duel",
  "classifications": ["StackDuel", "DDD", "Entity"],
  "identity": "StackDuel.Templates.Entity",
  "name": "StackDuel Domain Entity",
  "shortName": "sd-entity",
  "tags": { "language": "C#", "type": "item" },
  "sourceName": "Sample",
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "__NAMESPACE__",
      "defaultValue": "StackDuel.Domain",
      "description": "Namespace for the generated entity (e.g. StackDuel.Domain.Orders.Entities)."
    },
    "base": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "AggregateRoot",
          "description": "Root of its own aggregate, has its own repository and can raise domain events."
        },
        {
          "choice": "Entity",
          "description": "Child entity referenced by an aggregate root, no repository or domain events of its own."
        }
      ],
      "replaces": "__BASE__",
      "defaultValue": "AggregateRoot",
      "description": "Base class to derive from."
    }
  }
}
