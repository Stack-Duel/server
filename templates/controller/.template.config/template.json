{
  "$schema": "http://json.schemastore.org/template",
  "author": "Stack Duel",
  "classifications": ["StackDuel", "Api", "Controller"],
  "identity": "StackDuel.Templates.Controller",
  "name": "StackDuel Api Controller",
  "shortName": "sd-controller",
  "tags": { "language": "C#", "type": "item" },
  "sourceName": "Sample",
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "__NAMESPACE__",
      "defaultValue": "StackDuel.Api.Controllers",
      "description": "Namespace for the generated controller."
    },
    "serviceNamespace": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "__SERVICE_NAMESPACE__",
      "isRequired": true,
      "description": "Namespace of the I{Name}Service this controller depends on (e.g. StackDuel.Application.Services.Languages)."
    }
  }
}
