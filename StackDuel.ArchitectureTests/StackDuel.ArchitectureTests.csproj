<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      No coverlet.collector here on purpose. These tests use NetArchTest to load the product
      assemblies from disk and inspect their metadata; they execute almost no product code, so
      they contribute no meaningful line coverage. Instrumenting this project's output rewrites
      those assemblies and breaks the reflective load.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StackDuel.Api\StackDuel.Api.csproj" />
    <ProjectReference Include="..\StackDuel.Application\StackDuel.Application.csproj" />
    <ProjectReference Include="..\StackDuel.Domain\StackDuel.Domain.csproj" />
    <ProjectReference Include="..\StackDuel.Infrastructure\StackDuel.Infrastructure.csproj" />
  </ItemGroup>
</Project>
