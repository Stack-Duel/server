<Project>
  <!--
    Shared build configuration for every project in the solution.

    SonarQubeExclude marks auto-generated or data-only sources so SonarCloud leaves them out of
    analysis entirely (issues *and* coverage). Everything listed here is code we do not hand-write,
    so neither a code smell nor a missing test on it is actionable.

    The matching coverage-collector exclusions live in coverage.runsettings.
  -->
  <ItemGroup>
    <!-- EF Core migrations and the model snapshot are generated by `dotnet ef migrations add`. -->
    <Compile Update="Migrations\**\*.cs" SonarQubeExclude="true" />

    <!--
      Seeders are static reference/demo data expressed as C# object graphs. They hold no branching
      logic worth asserting on; the DbContext configuration they feed is what gets tested.
    -->
    <Compile Update="Persistence\Seeders\**\*.cs" SonarQubeExclude="true" />
  </ItemGroup>
</Project>
