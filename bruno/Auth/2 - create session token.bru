meta {
  name: 2 - Create Session Token
  type: http
  seq: 2
}

post {
  url: https://api.clerk.com/v1/sessions/{{session_id}}/tokens
  body: json
  auth: bearer
}

auth:bearer {
  token: {{process.env.CLERK_SECRET_KEY}}
}

body:json {
  {
    "expires_in_seconds": 3600
  }
}

script:post-response {
  bru.setEnvVar("access_token", res.body.jwt);
}
