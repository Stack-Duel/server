meta {
  name: 1 - Create Session
  type: http
  seq: 1
}

post {
  url: https://api.clerk.com/v1/sessions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{process.env.CLERK_SECRET_KEY}}
}

body:json {
  {
    "user_id": "{{process.env.CLERK_TEST_USER_ID}}"
  }
}

script:post-response {
  bru.setEnvVar("session_id", res.body.id);
}
